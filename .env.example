NODE_ENV=development
PORT=8080

# OpenAI Images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# S3 storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_IMAGE_PREFIX=uploads
S3_PDF_PREFIX=orders

# Email (Gmail SMTP)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
ORDER_EMAIL_TO=

# Clipdrop
CLIPDROP_API_KEY=
CLIPDROP_STATUS_URL_BASE=
ORDER_OUTPUT_DIR=

# Kakao webhook (optional)
KAKAO_WEBHOOK_URL=
KAKAO_WEBHOOK_TOKEN=

# Catalog build
CATALOG_ASSET_BASE_URL=
