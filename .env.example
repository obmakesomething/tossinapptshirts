NODE_ENV=development
PORT=8080

# Server configuration
REQUEST_TIMEOUT_MS=120000

# OpenAI Images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# Google Imagen (generate)
GOOGLE_API_KEY=
IMAGEN_MODEL=imagen-4.0-generate-001

# Background removal and AI upscale were removed from the print pipeline.
# Customers supply transparent PNGs, and low-resolution artwork is warned about
# rather than upscaled — so VERTEX_*, REMOVE_BG_PROVIDER and CLIPDROP_API_KEY
# are no longer read.

# Object storage (Vercel Blob)
# Provisioned automatically when a Blob store is linked to the Vercel project.
BLOB_READ_WRITE_TOKEN=
BLOB_IMAGE_PREFIX=uploads
BLOB_PDF_PREFIX=orders
# Design artwork is stored public (the app renders it directly); order PDFs are
# stored private because they contain the customer's name, phone and address.

# Database (Supabase Postgres)
# Supabase > Project Settings > Database > Connection string > URI
#   - Pooled (recommended for Cloud Run): port 6543, ...pooler.supabase.com
#   - Direct: port 5432, db.<ref>.supabase.co
# TLS is enabled automatically for any non-loopback host — no sslmode flag needed.
DATABASE_URL=
# Keep low: the transaction pooler caps connections and Cloud Run runs several instances
PG_POOL_MAX=5
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECT_TIMEOUT_MS=10000
# Escape hatch: skip TLS (local postgres, or Cloud SQL over a unix socket)
PG_DISABLE_SSL=false

# Toss withdrawal callback (유저정보 불러오기 > 콜백 정보)
# Console sends Authorization: Basic base64(username:password) to /v1/toss/disconnect
TOSS_CALLBACK_USERNAME=
TOSS_CALLBACK_PASSWORD=

# Email (Gmail SMTP)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
ORDER_EMAIL_TO=

ORDER_OUTPUT_DIR=

# Shared rate limit counters (Upstash Redis).
# Without these the limiter counts per instance, so the effective limit becomes
# max x warm instances. See server/rateLimitStore.js.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Kakao webhook (optional)
KAKAO_WEBHOOK_URL=
KAKAO_WEBHOOK_TOKEN=

# Catalog build
CATALOG_ASSET_BASE_URL=
