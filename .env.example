NODE_ENV=development
PORT=8080

# Server configuration
REQUEST_TIMEOUT_MS=120000
WEB_CONCURRENCY=2

# OpenAI Images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# Google Imagen (generate)
GOOGLE_API_KEY=
IMAGEN_MODEL=imagen-4.0-generate-001

# Remove background provider
# - vertex_imagen (default): Vertex Imagen edit (BGSWAP) + server-side chroma key to transparent PNG
# - clipdrop: Clipdrop remove-background (requires credits)
REMOVE_BG_PROVIDER=vertex_imagen

# Vertex AI (required when REMOVE_BG_PROVIDER=vertex_imagen)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
# Optional: API key for Vertex AI (Express mode). If unset, service account JSON or ADC will be used.
VERTEX_API_KEY=
# Imagen edit model (Vertex-only)
IMAGEN_EDIT_MODEL=imagen-3.0-capability-001
# Optional: Service account JSON (alternative to VERTEX_API_KEY)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Google Cloud Storage
GCS_UPLOAD_BUCKET=
GCS_ORDER_BUCKET=
GCS_IMAGE_PREFIX=uploads
GCS_PDF_PREFIX=orders
SIGNED_URL_TTL_SECONDS=604800

# Email (Gmail SMTP)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
ORDER_EMAIL_TO=

# Clipdrop
CLIPDROP_API_KEY=
CLIPDROP_STATUS_URL_BASE=
ORDER_OUTPUT_DIR=

# Kakao webhook (optional)
KAKAO_WEBHOOK_URL=
KAKAO_WEBHOOK_TOKEN=

# Catalog build
CATALOG_ASSET_BASE_URL=
