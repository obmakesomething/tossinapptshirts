NODE_ENV=development
PORT=8080

# Imagen (Google GenAI)
GEMINI_API_KEY=
GOOGLE_API_KEY=
IMAGEN_MODEL=imagen-4.0-generate-001
IMAGEN_API_VERSION=v1beta

# S3 storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_IMAGE_PREFIX=uploads
S3_PDF_PREFIX=orders

# Email (Gmail SMTP)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
ORDER_EMAIL_TO=

# Catalog build
CATALOG_ASSET_BASE_URL=
