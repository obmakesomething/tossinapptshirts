NODE_ENV=development
PORT=8080

# Server configuration
REQUEST_TIMEOUT_MS=120000
WEB_CONCURRENCY=2

# OpenAI Images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# Google Imagen (generate)
GOOGLE_API_KEY=
IMAGEN_MODEL=imagen-4.0-generate-001

# Background removal via internal rembg mask service
REMBG_MASK_BASE_URL=
REMBG_MASK_TIMEOUT_MS=25000
# Mask service tunables (used by server/rembg_service)
REMBG_MAX_INPUT_SIDE=1280
REMBG_MAX_CACHED_SESSIONS=0

# Google Cloud Storage
GCS_UPLOAD_BUCKET=
GCS_ORDER_BUCKET=
GCS_IMAGE_PREFIX=uploads
GCS_PDF_PREFIX=orders
SIGNED_URL_TTL_SECONDS=604800

# Email (Gmail SMTP)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
ORDER_EMAIL_TO=

ORDER_OUTPUT_DIR=

# Kakao webhook (optional)
KAKAO_WEBHOOK_URL=
KAKAO_WEBHOOK_TOKEN=

# Catalog build
CATALOG_ASSET_BASE_URL=
