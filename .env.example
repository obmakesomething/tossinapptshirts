NODE_ENV=development
PORT=8080
CORS_ORIGIN=https://*.apps.tossmini.com,https://*.private-apps.tossmini.com

# Google GenAI (Imagen)
GOOGLE_GENAI_API_KEY=
IMAGEN_MODEL=imagen-4.0-generate-001
GCP_PROJECT_ID=
GCP_LOCATION=asia-northeast3

# Storage
GCS_BUCKET=
PUBLIC_ASSET_BASE_URL=

# Background removal (Cloud Run service)
BG_REMOVE_SERVICE_URL=
BG_REMOVE_API_KEY=
BG_REMOVE_TIMEOUT_MS=10000

# Limits
MAX_UPLOAD_MB=10
MAX_IMAGE_PX=4096

# Security
SIGNING_SECRET=
