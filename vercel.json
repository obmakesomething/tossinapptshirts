{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo \"no build step: the API is served from api/index.js and public/ is static\"",
  "outputDirectory": "public",
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "regions": ["icn1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "assets/fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/mockups/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
