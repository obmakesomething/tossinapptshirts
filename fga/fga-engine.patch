diff --git a/scripts/audit-url.mjs b/scripts/audit-url.mjs
index c9de796..df48899 100644
--- a/scripts/audit-url.mjs
+++ b/scripts/audit-url.mjs
@@ -973,7 +973,12 @@ function extractElementsInPage({ unstablePatterns } = {}) {
     if (text && seenTexts.has(textKey)) continue;
     if (text) seenTexts.add(textKey);
     const attributes = {};
-    for (const name of ["aria-label", "role", "type", "placeholder", "alt", "href"]) {
+    // data-fga-role is the engine's own explicit text-role channel — inferTextRole
+    // reads attrs["data-fga-role"] at confidence 1.0 — but the URL capture was
+    // dropping it, so the declaration could never arrive and every screen fell
+    // back to the heuristic. It is the only way a React Native Web app can say
+    // "this is lead copy": there is no <p>, and class names are generated.
+    for (const name of ["aria-label", "role", "type", "placeholder", "alt", "href", "data-fga-role"]) {
       const value = el.getAttribute(name);
       if (value) attributes[name] = String(value).slice(0, 200);
     }
